<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <meta name="theme-color" content="#FBFAF6">

  <title>Flintstones</title>

  <!-- FLINTSTONES SITE ICON -->
  <link rel="icon" type="image/png" href="./flintstones_favicon.png">
  <link rel="shortcut icon" type="image/png" href="./flintstones_favicon.png">
  <link rel="apple-touch-icon" href="./flintstones_favicon.png">

  <style>

    :root {
      --gold: #B8860B;
      --gold2: #C99919;
      --cream: #FBFAF6;
      --line: #E8DFC7;
      --text: #161616;
      --muted: #666666;
    }


    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }


    html {
      width: 100%;
      min-height: 100%;
      background: var(--cream);
    }


    body {
      width: 100%;
      min-height: 100vh;
      min-height: 100dvh;

      margin: 0;

      background: var(--cream);

      color: var(--text);

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

      -webkit-font-smoothing: antialiased;
    }


    /* MAIN APP */

    .app {

      position: relative;

      width: 100%;
      max-width: 480px;

      min-height: 100vh;
      min-height: 100dvh;

      margin: 0 auto;

      background: var(--cream);

      overflow: hidden;
    }


    /* DECORATION */

    .corner-top {

      position: absolute;

      width: 220px;
      height: 220px;

      top: -120px;
      left: -110px;

      border-radius: 50%;

      background: var(--gold);

      box-shadow:
        0 0 0 20px var(--cream),
        0 0 0 35px var(--line);

      pointer-events: none;
    }


    .corner-bottom {

      position: absolute;

      width: 220px;
      height: 220px;

      bottom: -120px;
      right: -110px;

      border-radius: 50%;

      background: var(--gold);

      box-shadow:
        0 0 0 20px var(--cream),
        0 0 0 35px var(--line);

      pointer-events: none;
    }


    .stripes-top {

      position: absolute;

      width: 90px;
      height: 140px;

      right: -15px;
      top: 70px;

      opacity: 0.55;

      background:
        repeating-linear-gradient(
          90deg,
          transparent 0 8px,
          var(--line) 8px 16px
        );

      border-radius: 80px;

      pointer-events: none;
    }


    .stripes-bottom {

      position: absolute;

      width: 90px;
      height: 160px;

      left: -25px;
      bottom: 60px;

      opacity: 0.55;

      background:
        repeating-linear-gradient(
          90deg,
          transparent 0 8px,
          var(--line) 8px 16px
        );

      border-radius: 80px;

      pointer-events: none;
    }


    /* CONTENT */

    .content {

      position: relative;

      z-index: 5;

      padding:
        max(42px, env(safe-area-inset-top))
        28px
        max(38px, env(safe-area-inset-bottom));
    }


    /* NAVIGATION */

    nav {

      display: flex;

      justify-content: center;

      gap: 52px;

      margin-bottom: 55px;
    }


    .nav {

      position: relative;

      border: 0;

      background: transparent;

      padding: 0 0 8px;

      color: #777;

      font-family: inherit;

      font-size: 15px;

      font-weight: 700;

      letter-spacing: 2px;

      cursor: pointer;

      -webkit-appearance: none;
      appearance: none;
    }


    .nav.active {

      color: var(--gold);
    }


    .nav.active::after {

      content: "";

      position: absolute;

      left: 0;
      right: 0;
      bottom: 0;

      height: 3px;

      background: var(--gold);
    }


    /* PAGES */

    .page {

      display: none;
    }


    .page.active {

      display: block;

      animation: fadeIn 0.2s ease;
    }


    @keyframes fadeIn {

      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }

    }


    /* LOGO */

    .logo-wrap {

      text-align: center;

      margin-bottom: 55px;
    }


    .logo {

      width: 58px;

      margin: 0 auto 18px;
    }


    .logo-top,
    .logo-bottom {

      width: 58px;

      height: 27px;

      background: var(--text);
    }


    .logo-top {

      margin-bottom: 5px;

      border-radius: 30px 0 0 0;
    }


    .logo-bottom {

      border-radius: 0 0 30px 0;
    }


    .brand {

      font-size: clamp(42px, 12vw, 58px);

      line-height: 1;

      font-weight: 500;

      letter-spacing: -3px;
    }


    .reg {

      margin-left: 2px;

      font-size: 15px;

      vertical-align: top;
    }


    .tagline {

      margin-top: 22px;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.8;

      letter-spacing: 2px;

      text-transform: uppercase;
    }


    /* BUTTON AREA */

    .buttons {

      display: flex;

      flex-direction: column;

      gap: 18px;
    }


    /* ACTION BUTTON */

    .action {

      display: grid;

      grid-template-columns:
        68px
        1px
        minmax(0, 1fr)
        30px;

      align-items: center;

      width: 100%;

      min-height: 86px;

      padding: 0 22px;

      border-radius: 24px;

      background:
        linear-gradient(
          135deg,
          var(--gold),
          var(--gold2)
        );

      color: #ffffff;

      text-decoration: none;

      box-shadow:
        0 10px 24px
        rgba(184, 134, 11, 0.18);

      cursor: pointer;

      touch-action: manipulation;

      -webkit-user-select: none;
      user-select: none;
    }


    .action:active {

      opacity: 0.85;

      transform: scale(0.99);
    }


    /* ICONS */

    .icon {

      display: flex;

      align-items: center;

      justify-content: center;
    }


    .icon svg {

      width: 34px;

      height: 34px;

      fill: none;

      stroke: #ffffff;

      stroke-width: 2;

      stroke-linecap: round;

      stroke-linejoin: round;
    }


    .sep {

      width: 1px;

      height: 40px;

      background: rgba(255,255,255,0.55);
    }


    .label {

      padding-left: 24px;

      overflow: hidden;

      font-size: 18px;

      font-weight: 700;

      letter-spacing: 0.8px;

      white-space: nowrap;

      text-overflow: ellipsis;
    }


    .arrow {

      font-size: 28px;

      font-weight: 300;

      line-height: 1;
    }


    /* HOME FOOTER */

    .home-footer {

      margin-top: 75px;
    }


    .line {

      width: 48px;

      height: 3px;

      margin-bottom: 16px;

      background: var(--gold);
    }


    .small {

      color: var(--muted);

      font-size: 10px;

      letter-spacing: 3px;
    }


    .location {

      margin-top: 65px;
    }


    /* CONNECT */

    .connect-brand {

      margin-bottom: 35px;
    }


    .connect-brand .brand {

      font-size: 44px;
    }


    .connect-title {

      margin-bottom: 16px;

      text-align: center;

      font-size: 34px;

      font-weight: 800;
    }


    .connect-text {

      max-width: 340px;

      margin: 0 auto 36px;

      text-align: center;

      color: var(--muted);

      font-size: 15px;

      line-height: 1.6;
    }


    .thanks {

      margin-top: 58px;

      text-align: center;

      color: var(--muted);

      font-size: 10px;

      line-height: 2;

      letter-spacing: 4px;
    }


    .thanks .line {

      margin: 0 auto 18px;
    }


    /* SMALL PHONE SUPPORT */

    @media (max-width: 360px) {

      .content {

        padding-left: 20px;

        padding-right: 20px;
      }


      nav {

        margin-bottom: 45px;
      }


      .logo-wrap {

        margin-bottom: 45px;
      }


      .action {

        grid-template-columns:
          55px
          1px
          minmax(0, 1fr)
          25px;

        padding: 0 17px;
      }


      .label {

        padding-left: 18px;

        font-size: 16px;
      }

    }


    /* DESKTOP */

    @media (min-width: 600px) {

      body {

        padding: 30px;

        background: #EFE9DD;
      }


      .app {

        min-height: 850px;

        border-radius: 42px;

        box-shadow:
          0 30px 70px
          rgba(0,0,0,0.16);
      }

    }

  </style>

</head>


<body>


<div class="app">


  <!-- DECORATION -->

  <div class="corner-top"></div>

  <div class="corner-bottom"></div>

  <div class="stripes-top"></div>

  <div class="stripes-bottom"></div>


  <main class="content">


    <!-- NAVIGATION -->

    <nav>

      <button
        id="homeBtn"
        class="nav active"
        type="button"
        onclick="showPage('home')"
      >
        HOME
      </button>


      <button
        id="connectBtn"
        class="nav"
        type="button"
        onclick="showPage('connect')"
      >
        CONNECT
      </button>

    </nav>



    <!-- HOME PAGE -->

    <section
      id="home"
      class="page active"
    >


      <div class="logo-wrap">


        <div class="logo">

          <div class="logo-top"></div>

          <div class="logo-bottom"></div>

        </div>


        <div class="brand">

          Flintstones<span class="reg">®</span>

        </div>


        <div class="tagline">

          Natural Stones · Concrete Textures · Metal Artwork

        </div>


      </div>



      <div class="buttons">


        <!-- PORTFOLIO -->

        <a
          class="action"
          href="https://www.flintstones.in/portfolio"
        >


          <div class="icon">

            <svg viewBox="0 0 24 24">

              <rect
                x="3"
                y="4"
                width="18"
                height="16"
                rx="2"
              ></rect>


              <circle
                cx="8.5"
                cy="9"
                r="1.5"
              ></circle>


              <path
                d="M21 15l-5-5L5 20"
              ></path>

            </svg>

          </div>


          <div class="sep"></div>


          <div class="label">

            PORTFOLIO

          </div>


          <div class="arrow">

            →

          </div>


        </a>



        <!-- ABOUT US -->

        <a
          class="action"
          href="https://www.flintstones.in/about"
        >


          <div class="icon">

            <svg viewBox="0 0 24 24">

              <circle
                cx="12"
                cy="8"
                r="4"
              ></circle>


              <path
                d="M4 21v-2a8 8 0 0116 0v2"
              ></path>

            </svg>

          </div>


          <div class="sep"></div>


          <div class="label">

            ABOUT US

          </div>


          <div class="arrow">

            →

          </div>


        </a>


      </div>



      <div class="home-footer">


        <div class="line"></div>


        <div class="small">

          SHAPING SPACES NATURALLY

        </div>


        <div class="small location">

          BENGALURU

        </div>


      </div>


    </section>



    <!-- CONNECT PAGE -->

    <section
      id="connect"
      class="page"
    >


      <div class="logo-wrap connect-brand">


        <div class="logo">

          <div class="logo-top"></div>

          <div class="logo-bottom"></div>

        </div>


        <div class="brand">

          Flintstones<span class="reg">®</span>

        </div>


      </div>



      <div class="connect-title">

        LET'S CONNECT

      </div>



      <div class="connect-text">

        Find our location, visit our website or follow us on Instagram.

      </div>



      <div class="buttons">


        <!-- GOOGLE MAPS -->

        <a
          class="action"
          href="https://www.google.com/maps/search/?api=1&query=Flintstones%20Concrete%20Textures%20%26%20Stones&query_place_id=ChIJf0kncrsXrjsRl_r0OmO0hDA"
        >


          <div class="icon">

            <svg viewBox="0 0 24 24">

              <path
                d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1116 0z"
              ></path>


              <circle
                cx="12"
                cy="10"
                r="2.5"
              ></circle>

            </svg>

          </div>


          <div class="sep"></div>


          <div class="label">

            Google Maps

          </div>


          <div class="arrow">

            →

          </div>


        </a>



        <!-- WEBSITE -->

        <a
          class="action"
          href="https://www.flintstones.in/"
        >


          <div class="icon">

            <svg viewBox="0 0 24 24">

              <circle
                cx="12"
                cy="12"
                r="9"
              ></circle>


              <path
                d="M3 12h18"
              ></path>


              <path
                d="M12 3a15 15 0 010 18"
              ></path>


              <path
                d="M12 3a15 15 0 000 18"
              ></path>

            </svg>

          </div>


          <div class="sep"></div>


          <div class="label">

            Visit Website

          </div>


          <div class="arrow">

            →

          </div>


        </a>



        <!-- INSTAGRAM -->

        <a
          class="action"
          href="https://www.instagram.com/_flintstones__/"
        >


          <div class="icon">

            <svg viewBox="0 0 24 24">

              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="5"
              ></rect>


              <circle
                cx="12"
                cy="12"
                r="4"
              ></circle>


              <circle
                cx="17.5"
                cy="6.5"
                r="1"
              ></circle>

            </svg>

          </div>


          <div class="sep"></div>


          <div class="label">

            Instagram

          </div>


          <div class="arrow">

            →

          </div>


        </a>


      </div>



      <div class="thanks">


        <div class="line"></div>


        THANK YOU

        <br>

        FLINTSTONES


      </div>


    </section>


  </main>


</div>



<script>

function showPage(pageName) {

  var home =
    document.getElementById("home");

  var connect =
    document.getElementById("connect");

  var homeBtn =
    document.getElementById("homeBtn");

  var connectBtn =
    document.getElementById("connectBtn");


  if (pageName === "connect") {

    home.classList.remove("active");

    connect.classList.add("active");

    homeBtn.classList.remove("active");

    connectBtn.classList.add("active");

  }

  else {

    connect.classList.remove("active");

    home.classList.add("active");

    connectBtn.classList.remove("active");

    homeBtn.classList.add("active");

  }


  window.scrollTo(0, 0);

}

</script>


</body>

</html>
